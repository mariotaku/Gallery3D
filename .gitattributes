# The working tree is CRLF and the repository is LF. Without this git decides
# per file and renormalises on every add, which it warns about each time.
* text=auto eol=lf

# A shell reads a carriage return as part of the command, so a script checked
# out with CRLF fails on its first line with an error that names a character
# nothing printed. Marked text outright rather than left to text=auto, which
# decides per file and would leave a script it read as binary alone.
*.sh text eol=lf
gradlew text eol=lf

# cmd.exe finds a goto's label by reading the file line by line, and with bare
# LF endings it can miss one. gradlew.bat jumps between labels. Stored LF like
# everything else, checked out CRLF.
*.bat text eol=crlf

# Binary, so never touched.
*.png binary
*.jpg binary
*.ttf binary
