<?xml version="1.0" encoding="utf-8"?>
<!-- Sky traced from the original launcher icon: an amber ramp, a radial
     glow over the horizon, and a vignette into the corners. The ramp
     starts below the original photo's dark top edge, which was there to
     meet the bezel. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="67.71">
                <item android:offset="0" android:color="#FF8A4F00" />
                <item android:offset="0.1" android:color="#FF9A5D03" />
                <item android:offset="0.2" android:color="#FFA76908" />
                <item android:offset="0.3" android:color="#FFB1750E" />
                <item android:offset="0.4" android:color="#FFBA8013" />
                <item android:offset="0.5" android:color="#FFC28B16" />
                <item android:offset="0.6" android:color="#FFC9941B" />
                <item android:offset="0.7" android:color="#FFD09C1E" />
                <item android:offset="0.8" android:color="#FFD4A222" />
                <item android:offset="0.9" android:color="#FFD7A624" />
                <item android:offset="1" android:color="#FFD8A826" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The glow is wider than tall by 1/0.7, so it is drawn round and the
         group stretches it vertically about its own centre. -->
    <group android:scaleY="1.43" android:pivotX="55.44" android:pivotY="65.52">
        <path android:pathData="M-120,-120 H228 V228 H-120 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="55.44" android:centerY="65.52"
                    android:gradientRadius="51.84">
                    <item android:offset="0" android:color="#E6FFFFDE" />
                    <item android:offset="0.1" android:color="#D0FFFFDE" />
                    <item android:offset="0.2" android:color="#A5FFFFDE" />
                    <item android:offset="0.3" android:color="#7FFFFFDE" />
                    <item android:offset="0.4" android:color="#63FFFFDE" />
                    <item android:offset="0.5" android:color="#4BFFFFDE" />
                    <item android:offset="0.6" android:color="#33FFFFDE" />
                    <item android:offset="0.7" android:color="#1EFFFFDE" />
                    <item android:offset="0.8" android:color="#12FFFFDE" />
                    <item android:offset="0.9" android:color="#07FFFFDE" />
                    <item android:offset="1" android:color="#00FFFFDE" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="78">
                <item android:offset="0" android:color="#002E1300" />
                <item android:offset="0.12" android:color="#032E1300" />
                <item android:offset="0.25" android:color="#0B2E1300" />
                <item android:offset="0.38" android:color="#172E1300" />
                <item android:offset="0.5" android:color="#282E1300" />
                <item android:offset="0.62" android:color="#3D2E1300" />
                <item android:offset="0.75" android:color="#562E1300" />
                <item android:offset="0.88" android:color="#732E1300" />
                <item android:offset="1" android:color="#942E1300" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
