build/
# A second build tree, for building while the app from the first one is open.
build-verify/

# SDL's official Android archives, fetched by android/fetch-deps.sh. They carry
# prefab modules, so find_package(SDL3 CONFIG) works the same as on the desktop,
# and the org.libsdl.app Java classes the activity extends.
android/app/libs/
android/.gradle/
android/build/
android/local.properties
# Gradle keeps the native build tree under the module, not the project root.
android/app/build/
android/app/.cxx/
.claude/
out/
vcpkg_installed/
*.user

# Crash dumps, written next to the binary.
*.dmp
build-ios/

# Other projects' sources, one folder each under reference/. Not committed,
# because they are someone else's repositories and each is one command to get
# back.
#
# The Java this is a port of, at the tag it was taken from. Every file there
# has a counterpart under src/ with the same name:
#   git clone --depth 1 --branch android-2.3.7_r1 \
#     https://android.googlesource.com/platform/packages/apps/Gallery3D reference/gallery3d
#
# The iOS cross toolchain's source, for its documentation and SDK layout:
#   git clone --depth 1 --branch 1.19.2 https://github.com/xtool-org/xtool reference/xtool
#
# GLib, for the escaping g_filename_to_uri applies, which the freedesktop
# thumbnail cache hashes:
#   git clone --depth 1 https://gitlab.gnome.org/GNOME/glib.git reference/glib
#
# The freedesktop specifications, for the thumbnail cache's layout:
#   git clone --depth 1 https://gitlab.freedesktop.org/xdg/xdg-specs.git reference/xdg-specs
#
# Skia and the Android framework, for the sizes BitmapFactory and
# BitmapRegionDecoder give with inSampleSize. Sparse, only the codec code:
#   git clone --depth 1 --filter=blob:none --sparse --branch android14-release \
#     https://android.googlesource.com/platform/external/skia reference/skia
#   git -C reference/skia sparse-checkout set src/codec include/codec client_utils/android
#   git clone --depth 1 --filter=blob:none --sparse --branch android14-release \
#     https://android.googlesource.com/platform/frameworks/base reference/frameworks-base
#   git -C reference/frameworks-base sparse-checkout set libs/hwui/jni graphics/java/android/graphics
#
# SDL's Java classes and JNI glue, for what the native side needs from Java
# when SDLActivity does not start it:
#   git clone --depth 1 --filter=blob:none --sparse --branch release-3.4.16 \
#     https://github.com/libsdl-org/SDL reference/sdl
#   git -C reference/sdl sparse-checkout set android-project/app/src/main/java/org/libsdl/app src/core/android
#
# Android's document picker, for where ACTION_OPEN_DOCUMENT_TREE opens and
# which roots it lets a folder be chosen from:
#   git clone --depth 1 --filter=blob:none --sparse --branch android14-release \
#     https://android.googlesource.com/platform/packages/apps/DocumentsUI reference/documentsui
#   git -C reference/documentsui sparse-checkout set src/com/android/documentsui
#
# Picasso, for how it orients a MediaStore image:
#   git clone --depth 1 --branch fix-media-exif-orientation \
#     https://github.com/usuiat/picasso.git reference/picasso
#
# SDL's webOS fork, for what its video driver and public API offer a TV app:
#   git clone --depth 1 --branch release-3.4.16-webos.4 \
#     https://github.com/webosbrew/SDL-webOS.git reference/sdl-webos
reference/
